# Create a TMDB API key in your TMDB account and keep it server-side.
TMDB_API_KEY=replace-with-your-own-tmdb-v3-api-key

# Optional. Where accounts and sessions are stored (defaults to ./data/auth.json, which is git-ignored).
# DATA_DIR=./data

# Optional. Set to 1 when serving over HTTPS so the session cookie is marked Secure.
# SESSION_COOKIE_SECURE=0
